# ─── Frontend port ───────────────────────────────────────────────────────────
PORT=3501

# ─── Backend connection ───────────────────────────────────────────────────────
# URL of the Express backend — used by Next.js dev server to proxy /api/* requests
BACKEND_URL=http://localhost:3500

# ─── UI helpers (exposed to browser) ─────────────────────────────────────────
# Base URL shown in the config panel so users know where to point their clients
NEXT_PUBLIC_PROXY_URL=http://localhost:3500/proxy
